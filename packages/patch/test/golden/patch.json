{
  "version": 1,
  "cases": [
    {
      "name": "add-property",
      "input": {
        "document": {
          "a": 1
        },
        "patches": [
          {
            "op": "add",
            "path": "/b",
            "value": 2
          }
        ]
      },
      "expected": {
        "document": {
          "a": 1,
          "b": 2
        }
      }
    },
    {
      "name": "add-array-insert",
      "input": {
        "document": {
          "a": [1, 3]
        },
        "patches": [
          {
            "op": "add",
            "path": "/a/1",
            "value": 2
          }
        ]
      },
      "expected": {
        "document": {
          "a": [1, 2, 3]
        }
      }
    },
    {
      "name": "add-array-append",
      "input": {
        "document": {
          "a": [1]
        },
        "patches": [
          {
            "op": "add",
            "path": "/a/-",
            "value": 2
          }
        ]
      },
      "expected": {
        "document": {
          "a": [1, 2]
        }
      }
    },
    {
      "name": "remove-property",
      "input": {
        "document": {
          "a": 1,
          "b": 2
        },
        "patches": [
          {
            "op": "remove",
            "path": "/a"
          }
        ]
      },
      "expected": {
        "document": {
          "b": 2
        }
      }
    },
    {
      "name": "remove-array",
      "input": {
        "document": {
          "a": [1, 2, 3]
        },
        "patches": [
          {
            "op": "remove",
            "path": "/a/1"
          }
        ]
      },
      "expected": {
        "document": {
          "a": [1, 3]
        }
      }
    },
    {
      "name": "replace",
      "input": {
        "document": {
          "a": 1
        },
        "patches": [
          {
            "op": "replace",
            "path": "/a",
            "value": {
              "b": 2
            }
          }
        ]
      },
      "expected": {
        "document": {
          "a": {
            "b": 2
          }
        }
      }
    },
    {
      "name": "move",
      "input": {
        "document": {
          "a": {
            "x": 1
          },
          "b": {}
        },
        "patches": [
          {
            "op": "move",
            "from": "/a",
            "path": "/b/c"
          }
        ]
      },
      "expected": {
        "document": {
          "b": {
            "c": {
              "x": 1
            }
          }
        }
      }
    },
    {
      "name": "move-array",
      "input": {
        "document": {
          "a": [1, 2, 3]
        },
        "patches": [
          {
            "op": "move",
            "from": "/a/0",
            "path": "/a/2"
          }
        ]
      },
      "expected": {
        "document": {
          "a": [2, 3, 1]
        }
      }
    },
    {
      "name": "copy",
      "input": {
        "document": {
          "a": {
            "x": 1
          }
        },
        "patches": [
          {
            "op": "copy",
            "from": "/a",
            "path": "/b"
          },
          {
            "op": "replace",
            "path": "/b/x",
            "value": 2
          }
        ]
      },
      "expected": {
        "document": {
          "a": {
            "x": 1
          },
          "b": {
            "x": 2
          }
        }
      }
    },
    {
