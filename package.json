{
  "name": "sozai-repo",
  "version": "0.0.0",
  "private": true,
  "author": "Paul Le Cam",
  "type": "module",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:js",
    "build:js": "turbo run build:js",
    "build:types": "turbo run build:types",
    "check:skills": "kigu-check-skills",
    "clean": "pnpm -r build:clean",
    "format": "biome format --write .",
    "lint": "biome check --write ./packages",
    "prepare": "git config core.hooksPath .githooks",
    "release": "pnpm run build && pnpm publish -r",
    "test": "turbo run test:types test:unit"
  },
  "devDependencies": {
    "@kigu/dev": "catalog:"
  },
  "packageManager": "pnpm@11.18.0"
}
